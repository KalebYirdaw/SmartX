@page "/sensors"
@using System.Net.Http.Json
@using SmartX.Client.Services
@inject HttpClient Http

<PageTitle>Sensor Management</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Sensor Management</h1>
            <p class="text-muted mb-0">
                Register, monitor and manage Smart-X sensors.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="StartAddSensor">
            + Add Sensor
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (showForm)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h4 class="mb-3">
                    @(isEditing ? "Edit Sensor" : "Register Sensor")
                </h4>

                <EditForm Model="sensorForm"
                          OnValidSubmit="SaveSensor">

                    <DataAnnotationsValidator />

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">
                                MAC Address
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="sensorForm.MacAddress"
                                       disabled="@isEditing" />

                            <ValidationMessage For="@(() => sensorForm.MacAddress)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Location
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="sensorForm.Location" />

                            <ValidationMessage For="@(() => sensorForm.Location)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Category
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="sensorForm.Category">

                                <option value="">
                                    Select category
                                </option>

                                <option value="Temperature">
                                    Temperature
                                </option>

                                <option value="Power">
                                    Power
                                </option>

                                <option value="Water">
                                    Water
                                </option>

                                <option value="Valve">
                                    Valve
                                </option>

                                <option value="Environmental">
                                    Environmental
                                </option>

                            </InputSelect>

                            <ValidationMessage For="@(() => sensorForm.Category)" />
                        </div>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary me-2"
                                disabled="@isSaving">

                            @(isSaving ? "Saving..." :
                                isEditing ? "Update Sensor" :
                                "Register Sensor")

                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CancelForm">

                            Cancel

                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                Registered Sensors
            </h4>

            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="LoadSensors">

                Refresh

            </button>

        </div>

        <div class="card-body p-0">

            @if (isLoading)
            {
                <div class="p-4 text-center">
                    <div class="spinner-border"></div>
                    <p class="mt-2 mb-0">
                        Loading sensors...
                    </p>
                </div>
            }
            else if (sensors.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No sensors have been registered yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>MAC Address</th>
                                <th>Location</th>
                                <th>Category</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var sensor in sensors)
                            {
                                <tr>

                                    <td>
                                        <code>
                                            @sensor.MacAddress
                                        </code>
                                    </td>

                                    <td>
                                        @sensor.Location
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @sensor.Category
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => StartEditSensor(sensor)">

                                            Edit

                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteSensor(sensor.MacAddress)">

                                            Delete

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@code {

    private List<SensorDto> sensors = new();

    private SensorDto sensorForm = new();

    private bool showForm;
    private bool isEditing;
    private bool isLoading;
    private bool isSaving;

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensors();
    }

    private async Task LoadSensors()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result =
                await Http.GetFromJsonAsync<List<SensorDto>>(
                    "api/Sensor");

            sensors = result ?? new List<SensorDto>();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load sensors: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartAddSensor()
    {
        sensorForm = new SensorDto();

        isEditing = false;
        showForm = true;

        ClearMessages();
    }

    private void StartEditSensor(SensorDto sensor)
    {
        sensorForm = new SensorDto
        {
            MacAddress = sensor.MacAddress,
            Location = sensor.Location,
            Category = sensor.Category
        };

        isEditing = true;
        showForm = true;

        ClearMessages();
    }

    private async Task SaveSensor()
    {
        try
        {
            isSaving = true;
            ClearMessages();

            HttpResponseMessage response;

            if (isEditing)
            {
                response = await Http.PutAsJsonAsync(
                    $"api/Sensor/{Uri.EscapeDataString(sensorForm.MacAddress)}",
                    sensorForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync(
                    "api/Sensor",
                    sensorForm);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage =
                    isEditing
                        ? "Sensor updated successfully."
                        : "Sensor registered successfully.";

                showForm = false;

                await LoadSensors();
            }
            else
            {
                var error =
                    await response.Content.ReadFromJsonAsync<ErrorResponse>();

                errorMessage =
                    error?.Message ??
                    $"Request failed with status code {(int)response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSensor(string macAddress)
    {
        try
        {
            ClearMessages();

            var response =
                await Http.DeleteAsync(
                    $"api/Sensor/{Uri.EscapeDataString(macAddress)}");

            if (response.IsSuccessStatusCode)
            {
                successMessage =
                    "Sensor deleted successfully.";

                await LoadSensors();
            }
            else
            {
                var error =
                    await response.Content.ReadFromJsonAsync<ErrorResponse>();

                errorMessage =
                    error?.Message ??
                    $"Delete failed with status code {(int)response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to delete sensor: {ex.Message}";
        }
    }

    private void CancelForm()
    {
        showForm = false;
        sensorForm = new SensorDto();

        ClearMessages();
    }

    private void ClearMessages()
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    public class SensorDto
    {
        public string MacAddress { get; set; } = string.Empty;

        public string Location { get; set; } = string.Empty;

        public string Category { get; set; } = string.Empty;
    }

    public class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}