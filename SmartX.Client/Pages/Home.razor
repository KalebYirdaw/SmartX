@page "/"

@using SmartX.Client.Services
@inject SensorApiService SensorApiService
@inject TelemetryApiService TelemetryApiService

<PageTitle>SmartX</PageTitle>

<h1>SmartX Dashboard</h1>

<p>Select a sensor to view its latest telemetry and history.</p>

@if (loadingSensors)
{
    <p>Loading sensors...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (sensors.Count == 0)
{
    <div class="alert alert-warning">
        No sensors are currently available.
    </div>
}
else
{
    <div class="mb-3">
        <label for="sensorSelect" class="form-label">
            Select Sensor
        </label>

        <select id="sensorSelect"
                class="form-select"
                @bind="selectedSensorMac">
            @foreach (var sensor in sensors)
            {
                <option value="@sensor.MacAddress">
                    @sensor.MacAddress - @sensor.Location
                </option>
            }
        </select>
    </div>

    <button class="btn btn-primary"
            @onclick="LoadTelemetry">
        Load Telemetry
    </button>
}

@if (loadingTelemetry)
{
    <p class="mt-3">Loading telemetry...</p>
}

@if (latestReading != null)
{
    <h2 class="mt-4">Latest Reading</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="card-title">
                @latestReading.Metric
            </h3>

            <p class="display-6">
                @latestReading.Value
            </p>

            <p class="card-text">
                Sensor: @latestReading.SensorMacAddress
            </p>

            <p class="card-text">
                Time:
                @latestReading.Timestamp.ToLocalTime()
            </p>
        </div>
    </div>
}

@if (telemetry.Count > 0)
{
    <h2>Telemetry History</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Sensor</th>
                <th>Timestamp</th>
                <th>Metric</th>
                <th>Value</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reading in telemetry)
            {
                <tr>
                    <td>@reading.SensorMacAddress</td>
                    <td>@reading.Timestamp.ToLocalTime()</td>
                    <td>@reading.Metric</td>
                    <td>@reading.Value</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!loadingTelemetry && hasLoadedTelemetry)
{
    <div class="alert alert-info mt-3">
        No telemetry readings found for this sensor.
    </div>
}

@code {
    private List<SensorDto> sensors = new();
    private List<TelemetryDto> telemetry = new();

    private TelemetryDto? latestReading;

    private string selectedSensorMac = string.Empty;

    private bool loadingSensors;
    private bool loadingTelemetry;
    private bool hasLoadedTelemetry;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        loadingSensors = true;
        errorMessage = string.Empty;

        try
        {
            sensors = await SensorApiService.GetSensorsAsync();

            if (sensors.Count > 0)
            {
                selectedSensorMac = sensors[0].MacAddress;
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load sensors: {ex.Message}";
        }
        finally
        {
            loadingSensors = false;
        }
    }

    private async Task LoadTelemetry()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorMac))
        {
            return;
        }

        loadingTelemetry = true;
        hasLoadedTelemetry = false;
        errorMessage = string.Empty;

        try
        {
            telemetry =
                await TelemetryApiService.GetTelemetryAsync(
                    selectedSensorMac);

            latestReading = telemetry.FirstOrDefault();

            hasLoadedTelemetry = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load telemetry: {ex.Message}";

            latestReading = null;
        }
        finally
        {
            loadingTelemetry = false;
        }
    }
}