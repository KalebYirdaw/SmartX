@page "/"

@using SmartX.Client.Services
@using BlazorExpress.ChartJS

@implements IDisposable

@inject SensorApiService SensorApiService
@inject TelemetryApiService TelemetryApiService
@inject HttpClient Http

<PageTitle>SmartX</PageTitle>

<h1>Smart-X IoT Dashboard</h1>

<div class="card mb-4 border-primary">
    <div class="card-body">
        <h5>API Service Status</h5>
        @if (string.IsNullOrWhiteSpace(apiStatus))
        {
            <span class="badge bg-secondary">Checking API...</span>
        }
        else if (apiStatus == "Healthy")
        {
            <span class="badge bg-success">API Online</span>
            <span class="ms-2 text-muted">Last checked: @apiCheckedAt.ToLocalTime()</span>
        }
        else
        {
            <span class="badge bg-danger">API Unavailable</span>
            <p class="mb-0 mt-2">@apiStatus</p>
        }
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="CheckApi">Check API</button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5>1. Sensor Data Ingestion & Telemetry</h5>
            <p>Active: register sensors, generate simulated readings and monitor health.</p>
            <NavLink class="btn btn-primary" href="sensors">Manage Sensors</NavLink>
            <NavLink class="btn btn-outline-primary ms-2" href="telemetry">View Telemetry</NavLink>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5>2. Real-Time Command Stream & History</h5>
            <p>Active in Part 2: inspect the processing queues, simulate commands, undo the last command and view suggested actions.</p>
            <NavLink class="btn btn-primary" href="command-stream">Open Command Stream</NavLink>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5>3. Network Topology & Mesh Routing</h5>
            <p>Disabled for Part 3. Network map, mesh routes and routing analysis will be added in the final PoE.</p>
            <button class="btn btn-secondary" disabled>Coming in Part 3</button>
        </div></div>
    </div>
</div>

<p>
    Select a sensor to view its latest telemetry, health status,
    history, anomalies, and visual telemetry trends.
</p>

@if (loadingSensors)
{
    <p>Loading sensors...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (sensors.Count == 0)
{
    <div class="alert alert-warning">
        No sensors are currently available.
    </div>
}
else
{
    <div class="mb-3">
        <label for="sensorSelect" class="form-label">
            Select Sensor
        </label>

        <select id="sensorSelect"
                class="form-select"
                @bind="selectedSensorMac"
                @bind:after="LoadTelemetry">

            @foreach (var sensor in sensors)
            {
                <option value="@sensor.MacAddress">
                    @sensor.MacAddress - @sensor.Location
                </option>
            }

        </select>
    </div>

    <button class="btn btn-primary"
            @onclick="LoadTelemetry">
        Load Telemetry
    </button>
}

@if (sensorHealth != null)
{
    <h2 class="mt-4">Sensor Health</h2>

    <div class="card mb-4">
        <div class="card-body">

            @if (sensorHealth.Status == "Online")
            {
                <h3>🟢 Online</h3>
            }
            else if (sensorHealth.Status == "Stale")
            {
                <h3>🟠 Stale</h3>
            }
            else
            {
                <h3>🔴 Disconnected</h3>
            }

            <p class="card-text">
                <strong>Status:</strong>
                @sensorHealth.Status
            </p>

            <p class="card-text">
                @sensorHealth.Message
            </p>

            @if (sensorHealth.LastTelemetryTime.HasValue)
            {
                <p class="card-text">
                    <strong>Last telemetry:</strong>
                    @sensorHealth.LastTelemetryTime.Value.ToLocalTime()
                </p>

                <p class="card-text">
                    <strong>Minutes since last telemetry:</strong>
                    @sensorHealth.MinutesSinceLastTelemetry
                </p>
            }

        </div>
    </div>
}

@if (latestReading != null)
{
    <h2 class="mt-4">Latest Reading</h2>

    <div class="card mb-4">
        <div class="card-body">

            <h3 class="card-title">
                @latestReading.Metric
            </h3>

            <p class="display-6">
                @latestReading.Value
            </p>

            <p class="card-text">
                Sensor: @latestReading.SensorMacAddress
            </p>

            <p class="card-text">
                Time:
                @latestReading.Timestamp.ToLocalTime()
            </p>

            <p class="card-text text-muted">
                Automatically refreshing every 10 seconds.
            </p>

        </div>
    </div>
}

@if (anomalies.Count > 0)
{
    <h2 class="mt-4">⚠️ Anomalies Detected</h2>

    <div class="alert alert-warning">
        <strong>@anomalies.Count</strong>
        unusual telemetry reading(s) detected for this sensor.
    </div>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Timestamp</th>
                <th>Metric</th>
                <th>Value</th>
                <th>Reason</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var anomaly in anomalies)
            {
                <tr>

                    <td>
                        @anomaly.Timestamp.ToLocalTime()
                    </td>

                    <td>
                        @anomaly.Metric
                    </td>

                    <td>
                        <strong>@anomaly.Value</strong>
                    </td>

                    <td>
                        @anomaly.Reason
                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else if (hasLoadedTelemetry)
{
    <div class="alert alert-success mt-4">
        ✓ No telemetry anomalies detected for this sensor.
    </div>
}

@if (filteredTelemetry.Any())
{
    <h2 class="mt-4">Telemetry Visualization</h2>

    <div class="card mb-4">
        <div class="card-body">

            <div class="mb-3">

                <label for="chartMetricSelect" class="form-label">
                    Chart Metric
                </label>

                <select id="chartMetricSelect"
                        class="form-select"
                        @bind="chartMetric"
                        @bind:after="UpdateChart">

                    @foreach (var metric in availableMetrics)
                    {
                        <option value="@metric">
                            @metric
                        </option>
                    }

                </select>

            </div>

            @if (chartData != null)
            {
                <LineChart @ref="lineChart"
                           Width="800"
                           Height="400" />
            }
            else
            {
                <p class="text-muted">
                    Select a metric to display telemetry data.
                </p>
            }

        </div>
    </div>

    <h2 class="mt-4">Telemetry History</h2>

    <div class="mb-3">

        <label for="metricSelect" class="form-label">
            Filter by Metric
        </label>

        <select id="metricSelect"
                class="form-select"
                @bind="selectedMetric">

            <option value="All">
                All Metrics
            </option>

            @foreach (var metric in availableMetrics)
            {
                <option value="@metric">
                    @metric
                </option>
            }

        </select>

    </div>

    <table class="table">

        <thead>
            <tr>
                <th>Sensor</th>
                <th>Timestamp</th>
                <th>Metric</th>
                <th>Value</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var reading in filteredTelemetry)
            {
                <tr>

                    <td>
                        @reading.SensorMacAddress
                    </td>

                    <td>
                        @reading.Timestamp.ToLocalTime()
                    </td>

                    <td>
                        @reading.Metric
                    </td>

                    <td>
                        @reading.Value
                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else if (!loadingTelemetry && hasLoadedTelemetry)
{
    <div class="alert alert-info mt-3">
        No telemetry readings found for the selected metric.
    </div>
}

@if (loadingTelemetry)
{
    <p class="mt-3">Loading telemetry...</p>
}

@code
{
    private List<SensorDto> sensors = new();

    private List<TelemetryDto> telemetry = new();

    private List<TelemetryAnomalyDto> anomalies = new();

    private TelemetryDto? latestReading;

    private SensorHealthDto? sensorHealth;

    private string selectedSensorMac = string.Empty;

    private string selectedMetric = "All";

    private string chartMetric = string.Empty;

    private string apiStatus = string.Empty;
    private DateTime apiCheckedAt;
    private bool loadingSensors;

    private bool loadingTelemetry;

    private bool hasLoadedTelemetry;

    private string errorMessage = string.Empty;

    private PeriodicTimer? refreshTimer;

    private CancellationTokenSource? refreshCancellation;

    private LineChart lineChart = default!;

    private ChartData? chartData;

    private LineChartOptions lineChartOptions = new();

    private bool chartInitialized;

    private IEnumerable<string> availableMetrics =>
        telemetry
            .Select(t => t.Metric)
            .Distinct()
            .OrderBy(m => m);

    private IEnumerable<TelemetryDto> filteredTelemetry =>
        selectedMetric == "All"
            ? telemetry
            : telemetry.Where(t =>
                t.Metric.Equals(
                    selectedMetric,
                    StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CheckApi();
        loadingSensors = true;

        errorMessage = string.Empty;

        try
        {
            sensors =
                await SensorApiService.GetSensorsAsync();

            if (sensors.Count > 0)
            {
                selectedSensorMac =
                    sensors[0].MacAddress;

                await LoadTelemetry();
            }

            StartAutomaticRefresh();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load sensors: {ex.Message}";
        }
        finally
        {
            loadingSensors = false;
        }
    }

    private async Task CheckApi()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiHealthDto>("api/health");
            apiStatus = response?.Status ?? "Unknown API response";
            apiCheckedAt = DateTime.UtcNow;
        }
        catch
        {
            apiStatus = "Unable to reach API at configured address.";
        }
    }

    private sealed class ApiHealthDto
    {
        public string Status { get; set; } = string.Empty;
    }

    private async Task LoadTelemetry()
    {
        if (string.IsNullOrWhiteSpace(
                selectedSensorMac))
        {
            return;
        }

        loadingTelemetry = true;

        hasLoadedTelemetry = false;

        errorMessage = string.Empty;

        try
        {
            telemetry =
                await TelemetryApiService.GetTelemetryAsync(
                    selectedSensorMac);

            latestReading =
                telemetry.FirstOrDefault();

            anomalies =
                await TelemetryApiService.GetAnomaliesAsync(
                    selectedSensorMac);

            sensorHealth =
                await TelemetryApiService.GetSensorHealthAsync(
                    selectedSensorMac);

            if (telemetry.Count > 0)
            {
                if (string.IsNullOrWhiteSpace(chartMetric) ||
                    !availableMetrics.Contains(chartMetric))
                {
                    chartMetric =
                        availableMetrics.First();
                }

                chartInitialized = false;

                BuildChartData();
            }
            else
            {
                chartData = null;

                chartInitialized = false;
            }

            hasLoadedTelemetry = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load telemetry: {ex.Message}";

            latestReading = null;

            anomalies =
                new List<TelemetryAnomalyDto>();

            sensorHealth = null;

            chartData = null;

            chartInitialized = false;
        }
        finally
        {
            loadingTelemetry = false;
        }
    }

    private async Task UpdateChart()
    {
        if (string.IsNullOrWhiteSpace(chartMetric) ||
            !telemetry.Any())
        {
            return;
        }

        chartInitialized = false;

        BuildChartData();

        await InvokeAsync(
            StateHasChanged);
    }

    private void BuildChartData()
    {
        var chartReadings =
            telemetry
                .Where(t =>
                    t.Metric.Equals(
                        chartMetric,
                        StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.Timestamp)
                .TakeLast(100)
                .ToList();

        if (chartReadings.Count == 0)
        {
            chartData = null;
            return;
        }

        chartData = new ChartData
        {
            Labels =
                chartReadings
                    .Select(t =>
                        t.Timestamp
                            .ToLocalTime()
                            .ToString("HH:mm:ss"))
                    .ToList(),

            Datasets =
                new List<IChartDataset>
                {
                    new LineChartDataset
                    {
                        Label = chartMetric,

                        Data =
                            chartReadings
                                .Select(t =>
                                    (double?)t.Value)
                                .ToList()
                    }
                }
        };

        lineChartOptions =
            new LineChartOptions
            {
                Responsive = true
            };
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (chartData != null &&
            !chartInitialized)
        {
            try
            {
                await lineChart.InitializeAsync(
                    chartData,
                    lineChartOptions);

                chartInitialized = true;
            }
            catch (Exception ex)
            {
                errorMessage =
                    $"Unable to initialize telemetry chart: {ex.Message}";
            }
        }

        await base.OnAfterRenderAsync(
            firstRender);
    }

    private void StartAutomaticRefresh()
    {
        refreshCancellation =
            new CancellationTokenSource();

        refreshTimer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(10));

        _ = RefreshTelemetryAsync(
            refreshCancellation.Token);
    }

    private async Task RefreshTelemetryAsync(
        CancellationToken cancellationToken)
    {
        if (refreshTimer == null)
        {
            return;
        }

        try
        {
            while (await refreshTimer.WaitForNextTickAsync(
                cancellationToken))
            {
                if (string.IsNullOrWhiteSpace(
                        selectedSensorMac))
                {
                    continue;
                }

                await LoadTelemetry();

                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the page is disposed.
        }
    }

    public void Dispose()
    {
        refreshCancellation?.Cancel();

        refreshCancellation?.Dispose();

        refreshTimer?.Dispose();
    }
}