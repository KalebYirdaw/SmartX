
@page "/telemetry"
@using System.Net.Http.Json
@using SmartX.Client.Services
@inject HttpClient Http

<PageTitle>Telemetry</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Telemetry</h1>
            <p class="text-muted mb-0">
                Monitor sensor readings, health and detected anomalies.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="LoadTelemetry"
                disabled="@isLoading">
            Refresh
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <!-- Sensor Selection -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Select Sensor</h5>

            @if (sensors.Count == 0)
            {
                <p class="text-muted mb-0">
                    No sensors are registered.
                    Go to Sensor Management and register a sensor first.
                </p>
            }
            else
            {
                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label">
                            Sensor
                        </label>

                        <select class="form-select"
                                @bind="selectedSensorMac"
                                @bind:after="LoadTelemetry">

                            <option value="">
                                Select a sensor
                            </option>

                            @foreach (var sensor in sensors)
                            {
                                <option value="@sensor.MacAddress">
                                    @sensor.MacAddress - @sensor.Location
                                </option>
                            }

                        </select>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedSensorMac))
                    {
                        <div class="col-md-3">

                            <label class="form-label">
                                Metric
                            </label>

                            <select class="form-select"
                                    @bind="selectedMetric">

                                <option value="All">
                                    All Metrics
                                </option>

                                <option value="Temperature">
                                    Temperature
                                </option>

                                <option value="Power">
                                    Power
                                </option>

                                <option value="Valve">
                                    Valve
                                </option>

                            </select>

                        </div>

                        <div class="col-md-3">

                            <button class="btn btn-primary w-100"
                                    @onclick="SeedTelemetry"
                                    disabled="@isSeeding">

                                @(isSeeding
                                    ? "Generating..."
                                    : "Generate Mock Telemetry")

                            </button>

                        </div>
                    }

                </div>
            }

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(selectedSensorMac))
    {
        <!-- Sensor Health -->
        <div class="row g-4 mb-4">

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Sensor Health
                        </h6>

                        @if (sensorHealth == null)
                        {
                            <p class="text-muted">
                                Loading...
                            </p>
                        }
                        else
                        {
                            <h3 class="fw-bold">
                                @sensorHealth.Status
                            </h3>

                            <p class="mb-1">
                                @sensorHealth.Message
                            </p>

                            @if (sensorHealth.LastTelemetryTime.HasValue)
                            {
                                <small class="text-muted">
                                    Last reading:
                                    @sensorHealth.LastTelemetryTime.Value.ToLocalTime()
                                </small>
                            }
                        }

                    </div>

                </div>

            </div>

            <!-- Latest Reading -->
            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Latest Reading
                        </h6>

                        @if (telemetry.Count == 0)
                        {
                            <p class="text-muted">
                                No telemetry available.
                            </p>
                        }
                        else
                        {
                            var latest = telemetry
                                .OrderByDescending(x => x.Timestamp)
                                .First();

                            <h3 class="fw-bold">
                                @latest.Value
                            </h3>

                            <p class="mb-1">
                                @latest.Metric
                            </p>

                            <small class="text-muted">
                                @latest.Timestamp.ToLocalTime()
                            </small>
                        }

                    </div>

                </div>

            </div>

            <!-- Anomalies -->
            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Detected Anomalies
                        </h6>

                        <h3 class="fw-bold">
                            @anomalies.Count
                        </h3>

                        @if (anomalies.Count > 0)
                        {
                            <span class="badge bg-danger">
                                Attention Required
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                No Anomalies
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- Telemetry History -->
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">
                    Telemetry History
                </h5>
            </div>

            <div class="card-body p-0">

                @if (isLoading)
                {
                    <div class="p-4 text-center">

                        <div class="spinner-border"></div>

                        <p class="mt-2 mb-0">
                            Loading telemetry...
                        </p>

                    </div>
                }
                else if (!filteredTelemetry.Any())
                {
                    <div class="p-4 text-center text-muted">

                        No telemetry readings found.

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th>Timestamp</th>
                                    <th>Metric</th>
                                    <th>Value</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var reading in filteredTelemetry.Take(100))
                                {
                                    var isAnomaly = anomalies.Any(a =>
                                        a.Timestamp == reading.Timestamp &&
                                        a.Metric == reading.Metric &&
                                        a.Value == reading.Value);

                                    <tr>

                                        <td>
                                            @reading.Timestamp.ToLocalTime()
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @reading.Metric
                                            </span>
                                        </td>

                                        <td>
                                            <strong>
                                                @reading.Value
                                            </strong>
                                        </td>

                                        <td>

                                            @if (isAnomaly)
                                            {
                                                <span class="badge bg-danger">
                                                    Anomaly
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    Normal
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- Anomaly Details -->
        @if (anomalies.Count > 0)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        Anomaly Details
                    </h5>
                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th>Timestamp</th>
                                    <th>Metric</th>
                                    <th>Value</th>
                                    <th>Reason</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var anomaly in anomalies)
                                {
                                    <tr>

                                        <td>
                                            @anomaly.Timestamp.ToLocalTime()
                                        </td>

                                        <td>
                                            @anomaly.Metric
                                        </td>

                                        <td>
                                            <strong>
                                                @anomaly.Value
                                            </strong>
                                        </td>

                                        <td class="text-danger">
                                            @anomaly.Reason
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>

@code {

    private List<SensorDto> sensors = new();

    private List<TelemetryDto> telemetry = new();

    private List<TelemetryAnomalyDto> anomalies = new();

    private SensorHealthDto? sensorHealth;

    private string selectedSensorMac = string.Empty;

    private string selectedMetric = "All";

    private bool isLoading;

    private bool isSeeding;

    private string errorMessage = string.Empty;

    private IEnumerable<TelemetryDto> filteredTelemetry =>
        selectedMetric == "All"
            ? telemetry
            : telemetry.Where(x =>
                x.Metric.Equals(
                    selectedMetric,
                    StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadSensors();
    }

    private async Task LoadSensors()
    {
        try
        {
            errorMessage = string.Empty;

            var result =
                await Http.GetFromJsonAsync<List<SensorDto>>(
                    "api/Sensor");

            sensors = result ?? new List<SensorDto>();

            if (sensors.Count > 0 &&
                string.IsNullOrWhiteSpace(selectedSensorMac))
            {
                selectedSensorMac = sensors[0].MacAddress;

                await LoadTelemetry();
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load sensors: {ex.Message}";
        }
    }

    private async Task LoadTelemetry()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorMac))
            return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var telemetryResult =
                await Http.GetFromJsonAsync<List<TelemetryDto>>(
                    $"api/Telemetry/{Uri.EscapeDataString(selectedSensorMac)}");

            telemetry =
                telemetryResult ??
                new List<TelemetryDto>();

            var anomalyResult =
                await Http.GetFromJsonAsync<List<TelemetryAnomalyDto>>(
                    $"api/Telemetry/anomalies/{Uri.EscapeDataString(selectedSensorMac)}");

            anomalies =
                anomalyResult ??
                new List<TelemetryAnomalyDto>();

            sensorHealth =
                await Http.GetFromJsonAsync<SensorHealthDto>(
                    $"api/SensorHealth/{Uri.EscapeDataString(selectedSensorMac)}");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load telemetry: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SeedTelemetry()
    {
        if (string.IsNullOrWhiteSpace(selectedSensorMac))
            return;

        try
        {
            isSeeding = true;
            errorMessage = string.Empty;

            var response =
                await Http.PostAsync(
                    $"api/Telemetry/seed/{Uri.EscapeDataString(selectedSensorMac)}?count=100",
                    null);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"Telemetry generation failed with status code {(int)response.StatusCode}.";

                return;
            }

            await LoadTelemetry();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to generate telemetry: {ex.Message}";
        }
        finally
        {
            isSeeding = false;
        }
    }

    public class SensorDto
    {
        public string MacAddress { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }
}
